{
  "name": "stave",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "parity:refresh": "node packages/app/scripts/parity-refresh.mjs",
    "parity:bakery": "node packages/app/scripts/parity-bakery.mjs",
    "edit:coverage": "pnpm --filter @stave/app exec vitest run --config vitest.edit-coverage.config.ts",
    "edit:coverage:bakery": "node packages/app/scripts/edit-coverage-bakery.mjs",
    "gate:editing": "pnpm gate:editing:editor; e=$?; pnpm gate:editing:app; a=$?; pnpm gate:editing:instruments; i=$?; pnpm gate:editing:browser; b=$?; exit $((e|a|i|b))",
    "gate:editing:editor": "pnpm --filter @stave/editor exec vitest run --reporter=default --reporter=../app/tests/gate-scope-reporter.ts",
    "gate:editing:instruments": "pnpm --filter @stave/app run test:instruments:collect",
    "gate:editing:app": "pnpm --filter @stave/app exec node scripts/vitest-guard.mjs --reporter=default --reporter=../app/tests/gate-scope-reporter.ts",
    "gate:editing:browser": "pnpm --filter @stave/app exec playwright test --project=chromium --project=phone --project=phone-sideways --project=tablet --project=iphone --reporter=list,./tests/gate-population-reporter.ts",
    "gate:editing:browser:quick": "pnpm --filter @stave/app exec playwright test tests/sequencer.spec.ts tests/velocity.spec.ts tests/piano-roll.spec.ts tests/visual-edit-tabs.spec.ts tests/surgery-preserves-spelling.spec.ts tests/resolver-opens-a-grid.spec.ts tests/chord-chart-grid.spec.ts tests/counted-but-empty-views.spec.ts tests/sequencer-projection.spec.ts --project=chromium --workers=1 --reporter=list,./tests/gate-population-reporter.ts",
    "population": "pnpm --filter @stave/app run population"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "patchedDependencies": {
      "superdough@1.3.0": "patches/superdough@1.3.0.patch"
    }
  }
}
