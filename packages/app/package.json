{
  "name": "@stave/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-monaco.mjs && next dev",
    "build": "node scripts/copy-monaco.mjs && pnpm --filter @stave/docs build && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/vitest-guard.mjs",
    "test:proto": "vitest run --config vitest.proto.config.ts",
    "population": "node scripts/run-browser-population.mjs",
    "test:instruments:collect": "vitest run --config vitest.instruments.config.ts -t '$^' --reporter=default --reporter=./tests/gate-scope-reporter.ts"
  },
  "dependencies": {
    "@stave/editor": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vscode/codicons": "^0.0.45",
    "jszip": "^3.10.1",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@strudel/mini": "^1.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "acorn": "^8.17.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^24.0.0",
    "monaco-editor": "^0.50.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^1.6.0"
  }
}
